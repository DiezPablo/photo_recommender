{
  "name": "rasante",
  "version": "2.0.0",
  "private": true,
  "description": "Rasante: previsión para fotografía de paisaje y nocturna, y rutas de senderismo, en toda España",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prebuild": "node scripts/descargar-datos.mjs",
    "datos": "node scripts/descargar-datos.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
