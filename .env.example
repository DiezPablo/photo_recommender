# Copia este fichero como .env y rellénalo. Nunca subas .env al repo.

# Bot de Telegram (@BotFather → /newbot)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=          # para los avisos (python notificar.py --chat-id)
ALLOWED_USER_IDS=          # quién puede usar el bot (tu id; el bot te lo dice si lo dejas vacío)

# URLs públicas
WEBAPP_URL=                # Mini App, p. ej. https://usuario.github.io/spots-paisaje
PUBLIC_URL=                # servidor del bot, p. ej. https://spots-bot.onrender.com
WEBHOOK_SECRET=            # cadena aleatoria larga

# Opcional: guardar spots propios desde el bot
GITHUB_TOKEN=              # token fine-grained: Contents y Actions de lectura/escritura en este repo
GITHUB_REPO=               # usuario/spots-paisaje
GITHUB_BRANCH=main

# Ajustes
RADIO_KM=80
UMBRAL=6.5
